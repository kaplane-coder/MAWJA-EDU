# ==============================================================================
# MAWJA EDUCATION — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real secrets to git.

# ------------------------------------------------------------------------------
# 1. Next.js Public Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MAWJA Education"

# ------------------------------------------------------------------------------
# 2. Supabase Public Client Credentials (Browser & Client Components Safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. Supabase Server-Only Credentials (CRITICAL SECURITY BOUNDARY)
# ------------------------------------------------------------------------------
# WARNING: SUPABASE_SERVICE_ROLE_KEY grants full administrative access to your
# database and bypasses all Row Level Security (RLS) policies.
#
# RULES:
# - MUST NEVER be prefixed with NEXT_PUBLIC_
# - MUST NEVER be imported or referenced in Client Components ("use client")
# - MUST NEVER appear in browser bundles, network requests, logs, or error dumps
# - MUST ONLY be used in secure Node.js server environments / Server Actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
